#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# Full pipeline, in sequence, for each heatmap mode:
#   Stage 1 → (landmark_stats) → Stage 2 → evaluation + calibration
#   → Stage 2 analysis + comparison of the ways of combining the two stages
#
# Submit from the repository root (the logs/ folder must exist):
#   mkdir -p logs && sbatch run_tutto.slurm
# Only some modes / other settings:
#   sbatch --export=ALL,MODES="fixed" run_tutto.slurm
#   sbatch --export=ALL,MODES="learned_sigma probabilistic",BATCH_HEATMAP=8 run_tutto.slurm
# Quick test of the whole sequence (2 epochs per training):
#   sbatch --export=ALL,EPOCHS=2,OUT=esperimenti_prova --time=02:00:00 run_tutto.slurm
# Second run, starting Stage 1 from the per-landmark statistics measured in a
# previous run (STATS_DA/<mode>/landmark_stats.py) instead of the fallback values:
#   sbatch --export=ALL,MODES=probabilistic,STATS_DA=esperimenti,OUT=esperimenti_run2 run_tutto.slurm
# Stage 2 is combined with Stage 1 using the fixed parameters of src/parametri_stage2.py
# (copied into every experiment folder for the record).
#
# Results:  OUT/<mode>/  (default esperimenti/<mode>/)
#   modello_heatmap.pth, modello_refine.pth, landmark_stats.py (regenerated by this Stage 1),
#   landmark_stats_iniziali.py (only with STATS_DA), parametri_stage2.py,
#   calibrazione_incertezza.json, 1_train_heatmap.log, 2_train_refine.log, 3_evaluate.log,
#   analisi_stage2.csv, 4_analisi_stage2.log, 5_strategie_stage2.log
#
# Do NOT run two of these jobs at the same time in the same folder: they share
# src/landmark_stats.py.
# ─────────────────────────────────────────────────────────────────────────────
#SBATCH --job-name=ceph_tutto
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
#SBATCH --partition=gpu_L40S
#SBATCH --gres=gpu:1
#SBATCH --mem=40G
#SBATCH --time=24:00:00


set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"
export PYTHONUNBUFFERED=1
export PYTHONPATH="$(pwd)${PYTHONPATH:+:$PYTHONPATH}"

# ── Python environment ───────────────────────────────────────────────────────
# Conda env named "LLM" by default (CONDA_ENV=none: use the python already in PATH;
# with a venv, replace this block with: source <venv>/bin/activate)
CONDA_ENV="${CONDA_ENV:-LLM}"
if [ "$CONDA_ENV" != "none" ] && command -v conda >/dev/null 2>&1; then
    eval "$(conda shell.bash hook)"
    conda activate "$CONDA_ENV"
fi

# ── Pretrained HRNet weights without internet ───────────────────────────────
# Compute nodes are offline: timm loads hrnet_w48.ms_in1k from the shared
# Hugging Face cache of the cluster instead of downloading it.
export HF_HUB_CACHE="${HF_HUB_CACHE:-/hpc/groups/users-ai/LLM/cache/hub}"
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"
if ! ls "$HF_HUB_CACHE"/models--timm--hrnet_w48.ms_in1k/snapshots/*/model.safetensors >/dev/null 2>&1; then
    echo "ERROR: hrnet_w48.ms_in1k weights not found in $HF_HUB_CACHE"
    exit 1
fi

MODES="${MODES:-learned_sigma}"
BATCH_HEATMAP="${BATCH_HEATMAP:-16}"
BATCH_REFINE="${BATCH_REFINE:-16}"
OUT="${OUT:-esperimenti}"
STATS_DA="${STATS_DA:-}"        # empty = Stage 1 starts from the fallback statistics
EPOCHS="${EPOCHS:-}"            # empty = num_epochs of each script's CONFIG
EPOCH_ARGS=()
[ -n "$EPOCHS" ] && EPOCH_ARGS=(--epochs "$EPOCHS")
STATS="src/landmark_stats.py"

echo "Job ${SLURM_JOB_ID:-local} on $(hostname) — $(date)"
echo "Modes: $MODES | batch heatmap=$BATCH_HEATMAP refine=$BATCH_REFINE | epochs=${EPOCHS:-CONFIG} | output: $OUT"
if [ -n "$STATS_DA" ]; then
    echo "Initial Stage 1 statistics: $STATS_DA/<mode>/landmark_stats.py"
else
    echo "Initial Stage 1 statistics: fallback values"
fi
if [ -n "$STATS_DA" ] && [ "${STATS_DA%/}" = "${OUT%/}" ]; then
    echo "ERROR: STATS_DA and OUT are the same folder: the new run would overwrite the measurement"
    exit 1
fi
nvidia-smi || true
python -c "import torch; print('torch', torch.__version__, '| cuda', torch.cuda.is_available())"

mkdir -p "$OUT"
# A pre-existing landmark_stats.py would be used by the first Stage 1: move it aside
if [ -f "$STATS" ]; then
    BACKUP="$OUT/landmark_stats_preesistente_$(date +%Y%m%d_%H%M%S).py"
    echo "Moving the existing $STATS to $BACKUP"
    mv "$STATS" "$BACKUP"
fi

for MODE in $MODES; do
    DIR="$OUT/$MODE"
    mkdir -p "$DIR"
    echo
    echo "################################################################"
    echo "# heatmap_mode = $MODE   →   $DIR   ($(date))"
    echo "################################################################"

    # Initial per-landmark statistics of Stage 1 (loss weights, heatmap sigmas):
    # from the previous run if STATS_DA is set, otherwise the fallback values
    rm -f "$STATS"
    if [ -n "$STATS_DA" ]; then
        if [ ! -f "$STATS_DA/$MODE/landmark_stats.py" ]; then
            echo "ERROR: $STATS_DA/$MODE/landmark_stats.py not found"
            exit 1
        fi
        cp "$STATS_DA/$MODE/landmark_stats.py" "$STATS"
        cp "$STATS_DA/$MODE/landmark_stats.py" "$DIR/landmark_stats_iniziali.py"
        echo "Stage 1 starts from $STATS_DA/$MODE/landmark_stats.py"
    fi
    cp src/parametri_stage2.py "$DIR/parametri_stage2.py"

    echo "=== [$MODE] 1/4 Stage 1 training ==="
    python esegui_esperimento.py heatmap --mode "$MODE" --dir "$DIR" \
        --batch-size "$BATCH_HEATMAP" ${EPOCH_ARGS[@]+"${EPOCH_ARGS[@]}"} 2>&1 | tee "$DIR/1_train_heatmap.log"

    # train_heatmap regenerates src/landmark_stats.py from this Stage 1
    if [ -f "$STATS" ]; then
        cp "$STATS" "$DIR/landmark_stats.py"
    else
        echo "WARNING: $STATS was not generated"
    fi

    echo "=== [$MODE] 2/4 Stage 2 training ==="
    python esegui_esperimento.py refine --dir "$DIR" \
        --batch-size "$BATCH_REFINE" ${EPOCH_ARGS[@]+"${EPOCH_ARGS[@]}"} 2>&1 | tee "$DIR/2_train_refine.log"

    echo "=== [$MODE] 3/4 Evaluation + uncertainty calibration ==="
    python esegui_esperimento.py evaluate --dir "$DIR" 2>&1 | tee "$DIR/3_evaluate.log"

    # Measures how to combine the two stages on THIS run (nothing is saved:
    # to adopt the parameters, re-run strategie_stage2.py with --salva src/parametri_stage2.py)
    echo "=== [$MODE] 4/4 Stage 2 analysis + ways of combining Stage 1 and Stage 2 ==="
    python analisi_stage2.py --dir "$DIR" 2>&1 | tee "$DIR/4_analisi_stage2.log"
    python strategie_stage2.py "$DIR/analisi_stage2.csv" 2>&1 | tee "$DIR/5_strategie_stage2.log"
done

# Leave src/ clean: the statistics of each mode are in $OUT/<mode>/landmark_stats.py.
# For predict_heatmap.py copy the chosen one back to src/landmark_stats.py.
rm -f "$STATS"

echo
echo "Done — $(date)"
for MODE in $MODES; do
    echo "--- $MODE ---"
    grep -E "^Global MRE|within 2.0mm|Spearman\(sigma|coverage on held-out" "$OUT/$MODE/3_evaluate.log" || true
done
